# ============================================
# AI 测试平台 - 环境变量配置模板
# 使用方法：
#   1. cp .env.example .env
#   2. 编辑 .env 填入真实 AI Key
#   3. docker compose up -d （一键启动全部服务）
# ⚠️  请勿将真实的 .env 提交到 Git！
# ============================================

# Django 密钥（生产环境必须更换）
SECRET_KEY=change-me-to-a-random-50-char-string

# JWT 签名密钥（编排服务使用，可与 SECRET_KEY 相同）
JWT_SIGNING_KEY=change-me-jwt-signing-key

# 服务间通行令牌（编排服务 ↔ Django 内部调用）
SERVICE_TOKEN=change-me-service-token

# Agent Harness 底座地址（Django 侧优先调用，失败时降级到本地直连）
# Docker 内默认 http://ai-orchestrator:8001，本地开发默认 http://localhost:8001
AI_ORCHESTRATION_SERVICE_URL=http://localhost:8001

# ==================== 数据库 ====================
DB_PASSWORD=change-me-db-password

# ==================== LLM API 密钥（至少填一个） ====================
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# 通义千问 (DashScope): https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# 智谱 GLM: https://open.bigmodel.cn/
GLM_API_KEY=your-glm-api-key

# 默认 LLM Provider（可选: deepseek / dashscope / glm）
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-chat
